<UserControl x:Class="PimpMyWindows.Desktop.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="TweakTemplate">
      <Border Style="{StaticResource Card}">
        <Grid Opacity="{Binding RowOpacity}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Desired, Mode=TwoWay}"
                        IsEnabled="{Binding CanToggle}" Margin="0,1,16,0" />

          <StackPanel Grid.Column="1">
            <WrapPanel>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Border Style="{StaticResource RiskBadge}">
                <TextBlock Text="{Binding RiskText}" Style="{StaticResource RiskBadgeText}" />
              </Border>
              <Border Style="{StaticResource Tag}" Background="{DynamicResource AccentSoft}"
                      Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Recomendado" Style="{StaticResource TagText}" Foreground="{DynamicResource Accent}" />
              </Border>
              <Border Style="{StaticResource Tag}" Visibility="{Binding IsTechnical, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Técnico" Style="{StaticResource TagText}" />
              </Border>
              <Border Style="{StaticResource Tag}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Admin" Style="{StaticResource TagText}" />
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding UnavailableReason}" Foreground="{DynamicResource Warning}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,0" Visibility="{Binding UnavailableReason, Converter={StaticResource NotEmptyToVis}}" />
            <ToggleButton Style="{StaticResource LinkToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                          Margin="0,6,0,0" HorizontalAlignment="Left" Content="Saiba mais / menos" />
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Warning, StringFormat='Atenção: {0}'}" Foreground="{DynamicResource Warning}"
                         TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="{Binding RequirementsText}" FontSize="11" Foreground="{DynamicResource Muted}"
                         TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
            <Border Style="{StaticResource Tag}" Background="{DynamicResource InfoBg}"
                    Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="pendente" Style="{StaticResource TagText}" Foreground="{DynamicResource Info}" />
            </Border>
            <Border Style="{StaticResource Tag}" Visibility="{Binding HasStateTag, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding StateText}" Style="{StaticResource TagText}" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Ajustes" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
      </StackPanel>
      <TextBox Grid.Column="1" Width="290" Style="{StaticResource SearchBox}" Tag="Buscar ajustes…"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <WrapPanel>
        <Button Content="Marcar recomendados" Style="{StaticResource ChipButton}" Command="{Binding MarkCommand}" CommandParameter="recommended" />
        <Button Content="Marcar seguros" Style="{StaticResource ChipButton}" Command="{Binding MarkCommand}" CommandParameter="safe" />
        <Button Content="Marcar todos" Style="{StaticResource ChipButton}" Command="{Binding MarkCommand}" CommandParameter="all" />
        <Button Content="Limpar seleção" Style="{StaticResource ChipButton}" Command="{Binding MarkCommand}" CommandParameter="clear" />
      </WrapPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Exportar" Style="{StaticResource GhostButton}" Padding="12,5" Margin="0,0,8,0" Command="{Binding ExportCommand}" />
        <Button Content="Importar" Style="{StaticResource GhostButton}" Padding="12,5" Command="{Binding ImportCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
      <TextBlock Text="Perfis prontos:" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ItemsControl ItemsSource="{Binding Profiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Name}" ToolTip="{Binding Description}" Style="{StaticResource ChipButton}"
                    Command="{Binding DataContext.ProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ScrollViewer Grid.Row="3" Margin="0,8,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="{Binding FilterInfoText}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                   Margin="2,6,0,0"
                   Visibility="{Binding FilterInfoText, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TweakTemplate}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="4" Style="{StaticResource Card}" BorderBrush="{DynamicResource Accent}" Margin="0,12,0,0"
            Visibility="{Binding PendingCount, Converter={StaticResource NotZeroToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding PendingText}" FontWeight="SemiBold" />
          <TextBlock Text="Você confere cada mudança antes de qualquer coisa ser alterada." Foreground="{DynamicResource Muted}" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Descartar" Style="{StaticResource GhostButton}" Command="{Binding DiscardCommand}" Margin="0,0,10,0" />
          <Button Content="Revisar e aplicar" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
