<UserControl x:Class="PimpMyWindows.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,28,32,24" MaxWidth="920" HorizontalAlignment="Left">
      <TextBlock Text="Painel" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Um resumo do seu Windows e do que vale a pena fazer agora." Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />

      <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,22,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="150" Height="150" ToolTip="{Binding PercentExplanation}">
            <Ellipse Stroke="{DynamicResource Line}" StrokeThickness="12" />
            <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="12" StrokeDashCap="Round"
                     StrokeDashArray="{Binding RingDash}" RenderTransformOrigin="0.5,0.5"
                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
              <Ellipse.RenderTransform>
                <RotateTransform Angle="-90" />
              </Ellipse.RenderTransform>
            </Ellipse>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="{Binding PercentText}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Text="do essencial" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PercentExplanation}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0">
          <StackPanel>
            <TextBlock Text="{Binding ActiveText}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="ajustes ativos" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
          <StackPanel>
            <TextBlock Text="{Binding StartupText}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="programas na inicialização" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0">
          <StackPanel>
            <TextBlock Text="{Binding UndoText}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="ajustes que você pode desfazer" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Text="O QUE VALE A PENA OLHAR" Style="{StaticResource SectionTitle}" />
      <ItemsControl ItemsSource="{Binding Checklist}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SeverityDot}">
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource SeverityGlyph}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding Action}"
                        Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
