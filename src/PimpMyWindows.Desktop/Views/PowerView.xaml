<UserControl x:Class="PimpMyWindows.Desktop.Views.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Energia" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Escolha o plano de energia do Windows. Trocar é seguro: o plano anterior fica guardado e você volta com um clique, mesmo depois de fechar o programa."
                 Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,16,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <Border Style="{StaticResource Card}" Visibility="{Binding HasNotebookText, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding NotebookText}" TextWrapping="Wrap" />
        </Border>

        <ItemsControl ItemsSource="{Binding Plans}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <WrapPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Style="{StaticResource Tag}" Margin="10,0,0,0" Background="{DynamicResource AccentSoft}"
                              Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Ativo" Style="{StaticResource TagText}" Foreground="{DynamicResource Accent}" />
                      </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Usar este plano" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                          Margin="12,0,0,0" Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" Visibility="{Binding CanActivate, Converter={StaticResource BoolToVis}}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Button Content="Criar plano Desempenho máximo" Style="{StaticResource GhostButton}" Command="{Binding UltimateCommand}" Margin="0,0,8,0" />
          <Button Content="Voltar ao plano anterior" Style="{StaticResource GhostButton}" Command="{Binding RestoreCommand}" Margin="0,0,8,0" />
          <Button Content="Atualizar" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
