<UserControl x:Class="PimpMyWindows.Desktop.Views.DisksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Saúde dos discos" Style="{StaticResource PageTitle}" />
        <TextBlock Text="O estado de cada HD e SSD, como o próprio Windows enxerga. Esta tela só lê: nada é alterado."
                   Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="Atualizar" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,16,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Lendo os discos…" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding InfoText}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding InfoText, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding Disks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource SeverityDot}">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource SeverityGlyph}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <WrapPanel>
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Border Style="{StaticResource Tag}">
                        <TextBlock Text="{Binding VerdictText}" Style="{StaticResource TagText}" />
                      </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" Margin="0,2,0,8" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="Temperatura" Foreground="{DynamicResource Muted}" />
                      <TextBlock Grid.Column="1" Text="{Binding TemperatureText}" />
                      <TextBlock Grid.Row="1" Text="Desgaste" Foreground="{DynamicResource Muted}" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WearText}" />
                      <TextBlock Grid.Row="2" Text="Tempo ligado" Foreground="{DynamicResource Muted}" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HoursText}" />
                      <TextBlock Grid.Row="3" Text="Erros registrados" Foreground="{DynamicResource Muted}" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ErrorsText}" />
                    </Grid>
                    <TextBlock Text="{Binding NotesText}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
