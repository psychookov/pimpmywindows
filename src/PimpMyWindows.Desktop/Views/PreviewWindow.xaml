<Window x:Class="PimpMyWindows.Desktop.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:PimpMyWindows.Desktop.Theme"
        Title="Conferir antes de aplicar" Width="780" Height="620" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <theme:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
  </Window.Resources>
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Confira o que vai mudar" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
      <TextBlock Text="Cada ajuste guarda uma cópia do valor atual antes de mudar, e você pode desfazer tudo depois pela Central Desfazer."
                 Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding ActionText}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <Border Style="{StaticResource RiskBadge}">
                    <TextBlock Text="{Binding RiskText}" Style="{StaticResource RiskBadgeText}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Blocker}" Foreground="{DynamicResource Danger}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Blocker, Converter={StaticResource NotEmptyToVis}}" />
                <TextBlock Text="{Binding Warning, StringFormat='Atenção: {0}'}" Foreground="{DynamicResource Warning}"
                           Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Warning, Converter={StaticResource NotEmptyToVis}}" />
                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Muted}"
                                 TextWrapping="Wrap" Margin="0,1,0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock Text="{Binding RestartText}" Foreground="{DynamicResource Warning}" Margin="0,0,0,10" TextWrapping="Wrap"
                 Visibility="{Binding HasRestartText, Converter={StaticResource BoolToVis}}" />
      <Grid>
        <CheckBox Style="{StaticResource FlatCheck}" IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}"
                  Content="Criar um ponto de restauração antes (recomendado)" VerticalAlignment="Center"
                  Foreground="{DynamicResource Text}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancelar" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,10,0" Click="OnCancel" />
          <Button Content="Aplicar agora" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConfirm" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
