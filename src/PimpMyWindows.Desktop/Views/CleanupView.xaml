<UserControl x:Class="PimpMyWindows.Desktop.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Limpeza" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Libera espaço apagando só arquivos temporários conhecidos e parados há mais de um dia. Você vê a quantidade e o tamanho antes, e nada é apagado sem você marcar e confirmar."
                   Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="Analisar de novo" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
              Command="{Binding ScanCommand}" />
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,16,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Analisando…" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                            VerticalAlignment="Top" Margin="0,2,14,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold"
                             VerticalAlignment="Top" Margin="12,0,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource Success}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
      <Grid>
        <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" />
        <Button Content="Limpar marcados" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                Command="{Binding CleanCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
