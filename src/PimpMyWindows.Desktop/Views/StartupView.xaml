<UserControl x:Class="PimpMyWindows.Desktop.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Inicialização" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
      <TextBlock Text="Desativar é seguro: o programa continua instalado e você reativa quando quiser. Usamos o mesmo mecanismo do Gerenciador de Tarefas."
                 Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,16,-12,0" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Nenhum programa encontrado na inicialização." Foreground="{DynamicResource Muted}"
                   Visibility="{Binding Count, Converter={StaticResource ZeroToVis}}" />
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Command}" Foreground="{DynamicResource Muted}"
                               FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Style="{StaticResource Tag}" Background="{DynamicResource WarningBg}"
                            Visibility="{Binding FileMissing, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="programa não encontrado" Style="{StaticResource TagText}" Foreground="{DynamicResource Warning}" />
                    </Border>
                    <Border Style="{StaticResource Tag}" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="Admin" Style="{StaticResource TagText}" />
                    </Border>
                    <Border Style="{StaticResource Tag}">
                      <TextBlock Text="{Binding ScopeText}" Style="{StaticResource TagText}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
