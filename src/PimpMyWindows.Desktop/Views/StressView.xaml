<UserControl x:Class="PimpMyWindows.Desktop.Views.StressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="ResultText" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Info}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ResultKey}" Value="Ok">
          <Setter Property="Foreground" Value="{DynamicResource Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ResultKey}" Value="Warn">
          <Setter Property="Foreground" Value="{DynamicResource Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ResultKey}" Value="Bad">
          <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Teste de estresse" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Coloca o processador e a memória para trabalhar no máximo por alguns minutos e vê se o computador aguenta: se esquenta demais, perde velocidade ou apresenta erros de memória. Não grava nada no disco nem altera o Windows."
                 Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,16,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Escolha a duração" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="1 minuto" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"
                      Command="{Binding StartCommand}" CommandParameter="1" />
              <Button Content="5 minutos" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                      Command="{Binding StartCommand}" CommandParameter="5" />
              <Button Content="10 minutos" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                      Command="{Binding StartCommand}" CommandParameter="10" />
              <Button Content="Cancelar" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}"
                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Text="Feche os outros programas antes. Em notebook, deixe na tomada." Foreground="{DynamicResource Muted}"
                       FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Em andamento" Style="{StaticResource SectionTitle}" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="10" Margin="0,10,0,6"
                         Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" />
            <TextBlock Text="{Binding LiveText}" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Resultado" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding ResultText}" Style="{StaticResource ResultText}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
