<UserControl x:Class="PimpMyWindows.Desktop.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="GameTweakTemplate">
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Desired, Mode=TwoWay}"
                      IsEnabled="{Binding CanToggle}" Margin="0,1,14,0" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1">
          <WrapPanel>
            <TextBlock Text="{Binding Definition.Name}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Border Style="{StaticResource RiskBadge}">
              <TextBlock Text="{Binding RiskText}" Style="{StaticResource RiskBadgeText}" />
            </Border>
          </WrapPanel>
          <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
          <ToggleButton Style="{StaticResource LinkToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                        Margin="0,4,0,0" HorizontalAlignment="Left" Content="Saiba mais / menos" />
          <StackPanel Margin="0,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Warning, StringFormat='Atenção: {0}'}" Foreground="{DynamicResource Warning}"
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="2" Style="{StaticResource Tag}" VerticalAlignment="Top" Margin="12,0,0,0"
                Background="{DynamicResource AccentSoft}"
                Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Ativo" Style="{StaticResource TagText}" Foreground="{DynamicResource Accent}" />
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Jogos" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Seus jogos da Steam, Epic e GOG, com ajustes que valem só para cada jogo. Tudo passa pela prévia e pode ser desfeito na Central Desfazer."
                   Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Adicionar jogo" Style="{StaticResource GhostButton}" Command="{Binding AddCommand}" Margin="0,0,8,0" />
        <Button Content="Atualizar" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,16,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Procurando jogos…" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding InfoText}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding InfoText, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding Games}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <ContentControl Content="{Binding Gpu}" ContentTemplate="{StaticResource GameTweakTemplate}" />
                  <ContentControl Content="{Binding Fullscreen}" ContentTemplate="{StaticResource GameTweakTemplate}"
                                  Visibility="{Binding ShowTechnical, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"
            Visibility="{Binding PendingCount, Converter={StaticResource NotZeroToVis}}">
      <Grid>
        <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Limpar seleção" Style="{StaticResource GhostButton}" Command="{Binding DiscardCommand}" Margin="0,0,8,0" />
          <Button Content="Aplicar" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
