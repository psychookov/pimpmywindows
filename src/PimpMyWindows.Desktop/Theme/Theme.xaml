<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Cores padrão (tema escuro). O ThemeManager troca estes pincéis em tempo de execução;
       por isso tudo usa DynamicResource. -->
  <SolidColorBrush x:Key="AppBg" Color="#0A0E14" />
  <SolidColorBrush x:Key="SidebarBg" Color="#0E141B" />
  <SolidColorBrush x:Key="Surface" Color="#121820" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="#17202A" />
  <SolidColorBrush x:Key="SurfaceHover" Color="#1B2733" />
  <SolidColorBrush x:Key="Line" Color="#1E2833" />
  <SolidColorBrush x:Key="Text" Color="#E8EEF4" />
  <SolidColorBrush x:Key="Muted" Color="#8A97A6" />
  <SolidColorBrush x:Key="Accent" Color="#19D3A2" />
  <SolidColorBrush x:Key="AccentHover" Color="#3BE8B8" />
  <SolidColorBrush x:Key="OnAccent" Color="#04110D" />
  <SolidColorBrush x:Key="AccentSoft" Color="#0F3A33" />
  <SolidColorBrush x:Key="Success" Color="#3DDC97" />
  <SolidColorBrush x:Key="SuccessBg" Color="#12332A" />
  <SolidColorBrush x:Key="Warning" Color="#F5B63D" />
  <SolidColorBrush x:Key="WarningBg" Color="#3A2E12" />
  <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
  <SolidColorBrush x:Key="DangerBg" Color="#3A1A1C" />
  <SolidColorBrush x:Key="Info" Color="#5CB8FF" />
  <SolidColorBrush x:Key="InfoBg" Color="#12293D" />
  <SolidColorBrush x:Key="ToggleOff" Color="#3A4756" />

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- ===== Barra de rolagem fina ===== -->
  <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" Margin="2,0" CornerRadius="4" Background="{DynamicResource ToggleOff}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Muted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Botões ===== -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{DynamicResource Accent}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{DynamicResource OnAccent}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{DynamicResource Text}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChipButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                  BorderThickness="1" CornerRadius="15" Padding="14,6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{DynamicResource Text}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botão do menu lateral; Tag = "True" quando é a página atual. -->
  <Style x:Key="NavButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,10">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Interruptor (liga/desliga) ===== -->
  <Style x:Key="SwitchToggle" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Width="42" Height="24" Background="Transparent">
            <Border x:Name="Track" CornerRadius="12" Background="{DynamicResource ToggleOff}" />
            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                     HorizontalAlignment="Left" Margin="3,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Texto clicável que abre/fecha detalhes -->
  <Style x:Key="LinkToggle" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <ContentPresenter TextElement.Foreground="{DynamicResource Accent}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FlatCheck" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                    BorderBrush="{DynamicResource ToggleOff}" Background="Transparent" VerticalAlignment="Center">
              <Path x:Name="Mark" Data="M3,9 L7,13 L14,5" Stroke="{DynamicResource OnAccent}" StrokeThickness="2"
                    Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Campo de busca; o texto de dica vem em Tag. -->
  <Style x:Key="SearchBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
              <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}"
                         IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Cartões e selos ===== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style x:Key="Tag" TargetType="Border">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
  </Style>

  <Style x:Key="TagText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <!-- Selo de risco: DataContext precisa ter RiskKey = Safe | Moderate | Advanced -->
  <Style x:Key="RiskBadge" TargetType="Border" BasedOn="{StaticResource Tag}">
    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RiskKey}" Value="Moderate">
        <Setter Property="Background" Value="{DynamicResource WarningBg}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding RiskKey}" Value="Advanced">
        <Setter Property="Background" Value="{DynamicResource DangerBg}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="RiskBadgeText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
    <Setter Property="Foreground" Value="{DynamicResource Success}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RiskKey}" Value="Moderate">
        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding RiskKey}" Value="Advanced">
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Bolinha de severidade: DataContext precisa ter SeverityKey = Ok | Warn | Info -->
  <Style x:Key="SeverityDot" TargetType="Border">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding SeverityKey}" Value="Warn">
        <Setter Property="Background" Value="{DynamicResource WarningBg}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SeverityKey}" Value="Info">
        <Setter Property="Background" Value="{DynamicResource InfoBg}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SeverityKey}" Value="Bad">
        <Setter Property="Background" Value="{DynamicResource DangerBg}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SeverityGlyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Success}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding SeverityKey}" Value="Warn">
        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SeverityKey}" Value="Info">
        <Setter Property="Foreground" Value="{DynamicResource Info}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SeverityKey}" Value="Bad">
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Margin" Value="2,18,0,8" />
  </Style>

</ResourceDictionary>
