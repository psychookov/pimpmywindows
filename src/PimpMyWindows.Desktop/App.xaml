<Application x:Class="PimpMyWindows.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:PimpMyWindows.Desktop.Theme">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <theme:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
      <theme:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
      <theme:NotZeroToVisibilityConverter x:Key="NotZeroToVis" />
      <theme:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
