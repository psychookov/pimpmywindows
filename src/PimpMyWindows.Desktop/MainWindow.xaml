<Window x:Class="PimpMyWindows.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PimpMyWindows.Desktop.ViewModels"
        xmlns:views="clr-namespace:PimpMyWindows.Desktop.Views"
        Title="Pimp my Windows" Width="1200" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:OverviewPageViewModel}">
      <views:OverviewView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TweaksPageViewModel}">
      <views:TweaksView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StartupPageViewModel}">
      <views:StartupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PcPageViewModel}">
      <views:PcView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DriversPageViewModel}">
      <views:DriversView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DisksPageViewModel}">
      <views:DisksView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TestsPageViewModel}">
      <views:TestsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PowerPageViewModel}">
      <views:PowerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CleanupPageViewModel}">
      <views:CleanupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StressPageViewModel}">
      <views:StressView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:GamesPageViewModel}">
      <views:GamesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ControllerPageViewModel}">
      <views:ControllerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:UndoPageViewModel}">
      <views:UndoView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutPageViewModel}">
      <views:AboutView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Menu lateral -->
    <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="16,22,16,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="6,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Pimp" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
            <TextBlock Text=" my Windows" FontSize="20" FontWeight="Bold" />
          </StackPanel>
          <TextBlock Text="Otimização segura e reversível" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,-8,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding NavItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource NavButton}" Tag="{Binding IsSelected}" CommandParameter="{Binding Key}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Style="{StaticResource Tag}" Background="{DynamicResource Accent}" Margin="0"
                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{Binding BadgeText}" Style="{StaticResource TagText}" Foreground="{DynamicResource OnAccent}" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
          <Button Content="{Binding ModeButtonText}" Command="{Binding ToggleModeCommand}" Style="{StaticResource GhostButton}"
                  ToolTip="Alterna entre o Modo Básico (ajustes simples) e o Modo Técnico (ajustes avançados)." Margin="0,0,0,8" />
          <Button Content="Criar ponto de restauração" Command="{Binding RestorePointCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,8" />
          <Button Content="Executar como administrador" Command="{Binding ElevateCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,8"
                  Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}" />
          <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,12" />
          <TextBlock Text="{Binding OsDescription}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AdminStatusText}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Página atual + barra de status -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ContentControl Content="{Binding CurrentPage}" />
      <Border Grid.Row="1" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="32,10">
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
      </Border>
    </Grid>
  </Grid>
</Window>
